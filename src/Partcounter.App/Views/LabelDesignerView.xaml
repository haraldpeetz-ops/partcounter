<UserControl x:Class="Partcounter.Views.LabelDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Partcounter.Models"
             MinWidth="1000" MinHeight="650">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Etikettenvorlage" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                              DisplayMemberPath="DisplayName" MinHeight="30"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Vorlagenname" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" MinHeight="30"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Artikelzuordnung" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding ArticleAssignments}" SelectedItem="{Binding AssignedArticleNumber}"
                              IsEditable="True" MinHeight="30" ToolTip="Leer = keine feste Artikelzuordnung"/>
                </StackPanel>

                <WrapPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <CheckBox Content="Standard" IsChecked="{Binding IsDefault}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Neu" Command="{Binding NewTemplateCommand}" Margin="2" Padding="12,5"/>
                    <Button Content="Kopieren" Command="{Binding CloneTemplateCommand}" Margin="2" Padding="12,5"/>
                    <Button Content="Speichern" Command="{Binding SaveTemplateCommand}" Margin="2" Padding="12,5" FontWeight="SemiBold"/>
                    <Button Content="Löschen" Command="{Binding DeleteTemplateCommand}" Margin="2" Padding="12,5"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Elemente" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="Text" Command="{Binding AddElementCommand}" CommandParameter="Text" Margin="2"/>
                            <Button Content="Datenfeld" Command="{Binding AddElementCommand}" CommandParameter="DataText" Margin="2"/>
                            <Button Content="QR-Code" Command="{Binding AddElementCommand}" CommandParameter="QrCode" Margin="2"/>
                            <Button Content="Code128" Command="{Binding AddElementCommand}" CommandParameter="Code128" Margin="2"/>
                            <Button Content="Rahmen" Command="{Binding AddElementCommand}" CommandParameter="Rectangle" Margin="2"/>
                            <Button Content="Linie" Command="{Binding AddElementCommand}" CommandParameter="Line" Margin="2"/>
                            <Button Content="Bild / Logo" Command="{Binding AddElementCommand}" CommandParameter="Image" Margin="2" ToolTip="PNG, JPG, BMP, GIF oder TIFF einfügen"/>
                        </UniformGrid>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Content="Ausgewähltes Element löschen"
                            Command="{Binding DeleteElementCommand}" Margin="0,8,0,0" Padding="5"/>

                    <ListBox ItemsSource="{Binding Elements}" SelectedItem="{Binding SelectedElement}"
                             DisplayMemberPath="DisplayName" HorizontalContentAlignment="Stretch"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Format" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="2" ToolTip="Breite mm"/>
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="2" ToolTip="Höhe mm"/>
                        <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <Button Content="A5 quer" Command="{Binding ApplySizePresetCommand}" CommandParameter="A5Q" Margin="2"/>
                        <Button Content="A6 quer" Command="{Binding ApplySizePresetCommand}" CommandParameter="A6Q" Margin="2"/>
                        <Button Content="100×50" Command="{Binding ApplySizePresetCommand}" CommandParameter="100X50" Margin="2"/>
                        <Button Content="100×100" Command="{Binding ApplySizePresetCommand}" CommandParameter="100X100" Margin="2"/>
                        <Button Content="150×100" Command="{Binding ApplySizePresetCommand}" CommandParameter="150X100" Margin="2"/>
                    </WrapPanel>
                </Border>

                <Border Grid.Row="1" Background="#DDE2E8" BorderBrush="#C5CCD5" BorderThickness="1" CornerRadius="6" Padding="16">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Border Background="White" BorderBrush="#7A8694" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas x:Name="DesignerCanvas" Background="White" ClipToBounds="True"
                                    Focusable="True"/>
                        </Border>
                    </ScrollViewer>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Border Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Elementeigenschaften" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                        <TextBlock Text="Typ" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding ElementTypes}" SelectedItem="{Binding SelectedElement.Type}" Margin="0,2,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="X [mm]"/>
                                <TextBox Text="{Binding SelectedElement.Xmm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Y [mm]"/>
                                <TextBox Text="{Binding SelectedElement.Ymm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Breite [mm]"/>
                                <TextBox Text="{Binding SelectedElement.WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Höhe [mm]"/>
                                <TextBox Text="{Binding SelectedElement.HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F4F8FB" BorderBrush="#C8D7E5" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedElement.Type}" Value="{x:Static models:LabelElementType.Image}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Bild / Logo" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Button Content="Bilddatei auswählen …"
                                        Command="{Binding BrowseImageCommand}"
                                        CommandParameter="{Binding SelectedElement}"
                                        Padding="8,5" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding SelectedElement.ImageFileName, TargetNullValue=Noch kein Bild ausgewählt}"
                                           Foreground="#52606D" FontSize="11" Margin="0,5,0,4" TextWrapping="Wrap"/>
                                <CheckBox Content="Seitenverhältnis beibehalten"
                                          IsChecked="{Binding SelectedElement.PreserveAspectRatio}"/>
                                <TextBlock Text="Das Bild wird direkt in der Etikettenvorlage gespeichert. Empfohlen für Logos: PNG mit transparentem Hintergrund. Maximal 10 MB je Bild."
                                           Foreground="#66717E" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedElement.Type}" Value="{x:Static models:LabelElementType.Image}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Inhalt / Datenformat" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedElement.Content, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,2,0,8"/>

                            <TextBlock Text="Datenplatzhalter einfügen" FontWeight="SemiBold"/>
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Tokens}" SelectedItem="{Binding SelectedToken}"
                                          DisplayMemberPath="Token"/>
                                <Button Grid.Column="1" Content="Einfügen" Command="{Binding InsertTokenCommand}" Margin="6,0,0,0"/>
                            </Grid>

                            <Expander Header="Verfügbare Datenfelder" IsExpanded="False" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding Tokens}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Token}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#66717E" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Separator Margin="0,4,0,8"/>
                            <TextBlock Text="Schrift" FontWeight="SemiBold"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SelectedElement.FontFamily, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SelectedElement.FontSizePt, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" ToolTip="Punktgröße"/>
                            </Grid>
                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox Content="Fett" IsChecked="{Binding SelectedElement.Bold}" Margin="0,0,10,0"/>
                                <CheckBox Content="Kursiv" IsChecked="{Binding SelectedElement.Italic}" Margin="0,0,10,0"/>
                                <CheckBox Content="Unterstrichen" IsChecked="{Binding SelectedElement.Underline}"/>
                            </WrapPanel>

                            <TextBlock Text="Ausrichtung"/>
                            <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding SelectedElement.Alignment}" Margin="0,2,0,6"/>

                            <TextBlock Text="Linien-/Rahmenstärke"/>
                            <TextBox Text="{Binding SelectedElement.BorderThickness, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        </StackPanel>

                        <Border Background="#EFF4F8" CornerRadius="4" Padding="8" Margin="0,5,0,0">
                            <TextBlock Text="Elemente können in der Vorschau mit der Maus frei verschoben werden. Für maßgenaue Positionierung X/Y sowie Breite/Höhe direkt in Millimetern eingeben."
                                       TextWrapping="Wrap" Foreground="#425466" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#E9EEF3" BorderBrush="#D1D8E0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PrinterText, StringFormat=Drucker: {0}}" Foreground="#66717E" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Vorschau aktualisieren" Command="{Binding RefreshPreviewCommand}" Margin="3" Padding="10,5"/>
                    <Button Content="Testetikett drucken" Command="{Binding TestPrintCommand}" Margin="3" Padding="10,5" FontWeight="SemiBold"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
