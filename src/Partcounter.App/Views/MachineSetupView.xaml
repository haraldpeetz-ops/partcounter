<UserControl x:Class="Partcounter.Views.MachineSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="850" MinHeight="550">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Maschinen / Modbus TCP" FontSize="22" FontWeight="Bold"/>
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#465361"
                       Text="Hier werden die 30 LOGO!-Endpunkte konfiguriert. IP-Adresse und Port müssen exakt zur Modbus-Server-Konfiguration der jeweiligen Siemens LOGO! passen. Unit-ID ist standardmäßig 1. Änderungen werden gespeichert, aber erst nach einem Partcounter-Neustart von den Kommunikationsworkern übernommen."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,10,0,8">
            <Button Content="Neu laden" Command="{Binding ReloadCommand}" Padding="12,6"/>
            <Button Content="Empfohlenen IP-Plan 192.168.50.101–130 setzen"
                    Command="{Binding ApplyRecommendedPlanCommand}" Padding="12,6"/>
            <Button Content="Maschinen-/Modbus-Konfiguration speichern"
                    Command="{Binding SaveCommand}" Padding="12,6"/>
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Machines}" AutoGenerateColumns="False"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr." Binding="{Binding MachineNumber}" IsReadOnly="True" Width="55"/>
                <DataGridTextColumn Header="Maschinenname" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="LOGO! IP-Adresse" Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Width="165"/>
                <DataGridTextColumn Header="TCP-Port" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="Unit-ID" Binding="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled}" Width="65"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#EEF3F7" BorderBrush="#C9D4DE" BorderThickness="1"
                CornerRadius="5" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#657180"
                           Text="Siemens LOGO! 8/8.3: der Modbus-Server kann laut LOGO!Soft Comfort im Portbereich 502–510 betrieben werden; Partcounter verwendet im Standard Port 502. Für maximale Eindeutigkeit sollten alle 30 LOGO!-Stationen feste IP-Adressen erhalten und der Serverzugriff auf die IP des Partcounter-PCs beschränkt werden."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
